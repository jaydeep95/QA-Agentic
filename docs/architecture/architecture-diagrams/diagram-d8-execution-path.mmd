flowchart TB
  REQ["Execution request<br/>scope · environment · concurrency"] --> EM["Execution manager"]
  EM --> POL{"Policy gate<br/>environment permitted? secrets allowed?<br/>concurrency available?"}
  POL -->|denied| STOP["Rejected · audited"]
  POL -->|granted| LEASE["Environment lease"]
  LEASE --> Q[["Job queue — one job per test case"]]
  Q --> CC["Concurrency controller<br/>global · per environment · per run"]
  CC --> W["Playwright worker<br/>resolve secrets → browser context<br/>apply binding → run → collect artifacts"]
  W --> OBJ[("Object store<br/>trace · video · DOM · network")]
  W --> CB["Result callback API<br/>no direct database access"]
  CB --> TRI["Triage ladder"] --> EV["Evaluators"] --> FI["Findings + run history"]
  LEASE -.released.-> EM

