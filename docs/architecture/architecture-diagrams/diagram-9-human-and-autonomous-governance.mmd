flowchart TB
  GEN["Generate"] --> EVAL["Evaluate"]
  EVAL --> PKG["Gate package<br/>artifact · verdicts · confidence · oracle coverage<br/>unresolved conflicts · budget"]
  PKG --> GATE{"<b>Governance Gate</b><br/>one implementation"}
  GATE -->|human mode| H["Approve · Edit · Reject"]
  GATE -->|autonomous mode| A["Policy: Continue · Stop · Escalate"]
  H --> D["Decision record<br/>actor · rationale · policy version"]
  A --> D
  A -->|escalate| ESC["Escalation work item"]
  ESC --> H
  D --> FROZEN["Approved version frozen · immutable"]
  FROZEN --> NEXT["Next stage"]
  D --> AUD[("Append-only audit")]

